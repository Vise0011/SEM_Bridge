# Local development only. Replace these values in your private .env file.
POSTGRES_DB=sme_bridge
POSTGRES_USER=sme_bridge
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5432

NEO4J_PASSWORD=replace-with-a-local-neo4j-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Request a key from https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi
BIZINFO_API_KEY=

# run_local.py uses SQLite by default; Compose uses PostgreSQL.
STORAGE_BACKEND=postgres
SQLITE_PATH=data/local/bridge.sqlite3

# Local tools are disabled for normal uvicorn/Compose startup.
# run_local.py enables them on 127.0.0.1; --read-only disables them again.
LOCAL_MANAGEMENT_ENABLED=false
OCR_TESSDATA_PATH=data/local/tessdata
